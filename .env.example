# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=
PLATFORM_DB_NAME=platform
SESSION_SECRET=
# Base domain used for tenant subdomains, e.g. localhost:3000 locally
PLATFORM_BASE_DOMAIN=localhost:3000
SETUP_KEY=

# --- Real email (optional; without these, emails are recorded in the admin but not delivered) ---
# Create a key at resend.com, verify your sending domain there, then set both:
RESEND_API_KEY=
EMAIL_FROM=orders@your-domain.com

# --- Daily housekeeping job (Vercel Cron sends this as a Bearer token). Use 16+ random characters. ---
CRON_SECRET=

# --- Optional: separate key for encrypting store owners' payment keys (defaults to a key derived from SESSION_SECRET).
# Set it BEFORE owners connect accounts; changing it later makes stored keys unreadable (owners would reconnect).
ENCRYPTION_KEY=
